# Clean Code examples

```ts
// ❌ nested if + else
function resolveCanDelete<T>(canDelete: boolean | ((row: T) => boolean), row: T) {
  if (typeof canDelete === "function") {
    if (canDelete(row)) {
      return true;
    } else {
      return false;
    }
  } else {
    return canDelete;
  }
}

// ✅ guard clauses, no else
function resolveCanDelete<T>(canDelete: boolean | ((row: T) => boolean), row: T): boolean {
  if (typeof canDelete === "function") return canDelete(row);
  return canDelete;
}
```

```ts
// ❌ mutate sort in place
function nextSort(current: { columnId: string; direction: "asc" | "desc" } | null, columnId: string) {
  if (current && current.columnId === columnId) {
    current.direction = current.direction === "asc" ? "desc" : "asc";
    return current;
  }
  return { columnId, direction: "asc" as const };
}

// ✅ immutable next state
function nextSort(current: { columnId: string; direction: "asc" | "desc" } | null, columnId: string) {
  if (!current || current.columnId !== columnId) {
    return { columnId, direction: "asc" as const };
  }
  if (current.direction === "asc") return { columnId, direction: "desc" as const };
  return null;
}
```
